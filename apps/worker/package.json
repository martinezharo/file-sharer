{
  "name": "@file-sharer/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate:local && wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply file-sharer-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply file-sharer-db --remote"
  },
  "dependencies": {
    "@file-sharer/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  }
}
